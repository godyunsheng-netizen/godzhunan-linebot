# LINE Developers Console 取得
LINE_CHANNEL_ID=your_liff_channel_id

# 公司WiFi的DDNS網域（路由器設定DDNS後綁定的網域）
COMPANY_DDNS_HOSTNAME=ganyincha.ddns.net

# 是否允許本機測試時跳過IP驗證（正式環境務必設為 false）
SKIP_NETWORK_CHECK=true

# 測試模式：跳過真的LINE登入驗證，方便還沒申請LIFF ID前先測打卡流程
# 正式上線前務必改成 false
TEST_MODE=true

PORT=8080

# Google Sheets 永久紀錄（選填，不設定則只存在SQLite）
# 服務帳號的Email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# 服務帳號的私鑰（JSON金鑰檔中的private_key欄位，換行請保留\n）
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Google試算表網址中 /d/ 後面那一串英數字
GOOGLE_SHEET_ID=your_google_sheet_id

# 每月月報（選填，不設定則不會發送月報）
# LINE Official Account Manager > 設定 > Messaging API 頁面取得的頻道存取權杖
LINE_CHANNEL_ACCESS_TOKEN=your_line_messaging_api_channel_access_token
# 要收月報的LINE使用者ID（自己跟機器人對話一次，從打卡紀錄或webhook log裡可以查到）
LINE_OWNER_USER_ID=your_line_user_id
# 月報檔案要分享給誰的Google帳號（通常就是你自己的Gmail）
OWNER_GOOGLE_EMAIL=your@gmail.com
# 防止月報端點被亂打，自訂一組密鑰，GitHub Actions排程觸發時要帶一樣的值
REPORT_CRON_SECRET=change_me_to_a_random_string

# 手動修正打卡紀錄頁面（/admin）的登入密碼，只有老闆自己知道
ADMIN_PASSWORD=change_me_to_a_random_password
