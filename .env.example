# LINE Developers Console 取得
LINE_CHANNEL_ID=your_liff_channel_id

# 公司WiFi的DDNS網域（路由器設定DDNS後綁定的網域）
COMPANY_DDNS_HOSTNAME=ganyincha.ddns.net

# 是否允許本機測試時跳過IP驗證（正式環境務必設為 false）
SKIP_NETWORK_CHECK=true

# 測試模式：跳過真的LINE登入驗證，方便還沒申請LIFF ID前先測打卡流程
# 正式上線前務必改成 false
TEST_MODE=true

PORT=8080

# Google Sheets 永久紀錄（選填，不設定則只存在SQLite）
# 服務帳號的Email
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# 服務帳號的私鑰（JSON金鑰檔中的private_key欄位，換行請保留\n）
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Google試算表網址中 /d/ 後面那一串英數字
GOOGLE_SHEET_ID=your_google_sheet_id
